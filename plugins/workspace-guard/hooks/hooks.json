{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/guard.py"],
            "timeoutMs": 5000,
            "statusMessage": "workspace-guard 检查中"
          }
        ]
      }
    ]
  }
}
