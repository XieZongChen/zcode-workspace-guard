[
  {"name": "C1 危险门关闭后无路径危险命令放行", "tool_name": "Bash",
   "config": {"danger_gate_enabled": false},
   "tool_input": {"command": ":(){ :|:& };:"}, "expect": {"decision": null}},
  {"name": "C2 两能力独立：门关围栏仍拦界外写入", "tool_name": "Write",
   "config": {"danger_gate_enabled": false, "sandbox_enabled": true},
   "tool_input": {"file_path": "{OUT}/f.txt", "content": "x"}, "expect": {"decision": "ask", "reason_contains": "项目"}},
  {"name": "C3 自定义危险规则命中", "tool_name": "Bash",
   "config": {"danger_rules": "git\\s+push\\s+--force"},
   "tool_input": {"command": "git push --force origin main"}, "expect": {"decision": "ask", "reason_contains": "自定义"}},
  {"name": "C4 非法正则跳行不崩合法行仍命中", "tool_name": "Bash",
   "config": {"danger_rules": "([\n^sudo\\s+reboot$"},
   "tool_input": {"command": "sudo reboot"}, "expect": {"decision": "ask", "reason_contains": "自定义"}},
  {"name": "C5a 围栏关闭后界外文件写入放行", "tool_name": "Write",
   "config": {"sandbox_enabled": false},
   "tool_input": {"file_path": "{OUT}/f.txt", "content": "x"}, "expect": {"decision": null}},
  {"name": "C5b 围栏关闭后界外重定向放行", "tool_name": "Bash",
   "config": {"sandbox_enabled": false},
   "tool_input": {"command": "echo x > {OUT}/f"}, "expect": {"decision": null}},
  {"name": "C6 配置文件缺失回落默认值", "tool_name": "Bash",
   "config_missing": true,
   "tool_input": {"command": "rm -rf /"}, "expect": {"decision": "ask", "reason_contains": "危险"}},
  {"name": "C7 门关后 rm -rf / 仍被围栏拦截(两层叠加)", "tool_name": "Bash",
   "config": {"danger_gate_enabled": false},
   "tool_input": {"command": "rm -rf /"}, "expect": {"decision": "ask", "reason_contains": "越界"}},
  {"name": "C8 清单为空串=启用全部内置", "tool_name": "Bash",
   "config": {"danger_rules": ""},
   "tool_input": {"command": "rm -rf /"}, "expect": {"decision": "ask", "reason_contains": "危险"}},
  {"name": "C9 删除 rm 内置后围栏仍拦 rm -rf /", "tool_name": "Bash",
   "config": {"danger_rules": "fork-bomb"},
   "tool_input": {"command": "rm -rf /"}, "expect": {"decision": "ask", "reason_contains": "越界"}},
  {"name": "C10 仅注释行=无规则", "tool_name": "Bash",
   "config": {"danger_rules": "# 全部停用"},
   "tool_input": {"command": ":(){ :|:& };:"}, "expect": {"decision": null}},
  {"name": "C11 换行分隔混排(手编config场景)", "tool_name": "Bash",
   "config": {"danger_rules": "rm-destructive\ngit\\s+push\\s+--force"},
   "tool_input": {"command": "git push --force origin main"}, "expect": {"decision": "ask", "reason_contains": "自定义"}},
  {"name": "C12 分号分隔混排(UI标准格式)", "tool_name": "Bash",
   "config": {"danger_rules": "rm-destructive;git\\s+push\\s+--force"},
   "tool_input": {"command": "git push --force origin main"}, "expect": {"decision": "ask", "reason_contains": "自定义"}},
  {"name": "C13 分号清单注释段跳过", "tool_name": "Bash",
   "config": {"danger_rules": "fork-bomb;#备注;dd-device"},
   "tool_input": {"command": "dd if=/dev/zero of=/dev/disk9"}, "expect": {"decision": "ask", "reason_contains": "危险"}}
]
